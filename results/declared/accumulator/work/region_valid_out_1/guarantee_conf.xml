		<prop exp="valid_in == 0 &amp;&amp; data_in == data_out" loc="a,dt"/>
		<prop exp="valid_in == 1 &amp;&amp; data_in == data_out" loc="a,dt"/>
		<prop exp="valid_in == 1 &amp;&amp; data_in &gt;= data_out" loc="a,dt"/>
		<prop exp="rst_n == 1 &amp;&amp; data_in == data_out" loc="a,dt"/>
		<prop exp="valid_in == 0 &amp;&amp; data_in &lt; data_out" loc="a,dt"/>
		<prop exp="rst_n == 1 &amp;&amp; valid_in == 0 &amp;&amp; valid_out == 0" loc="a,dt"/>
		<prop exp="valid_in == 0 &amp;&amp; valid_out == 1 &amp;&amp; data_out &lt;= 255" loc="a,dt"/>
		<prop exp="valid_in == 1 &amp;&amp; valid_out == 1 &amp;&amp; data_out &lt;= 255" loc="a,dt"/>
		<prop exp="rst_n == 1 &amp;&amp; valid_in == 0 &amp;&amp; data_out == 0" loc="a,dt"/>
		<prop exp="rst_n == 1 &amp;&amp; valid_out == 0 &amp;&amp; data_out == 0" loc="a,dt"/>
		<prop exp="rst_n == 1 &amp;&amp; valid_in == 0 &amp;&amp; data_out &lt;= 255" loc="a,dt"/>
		<prop exp="valid_in == 1 &amp;&amp; valid_out == 0 &amp;&amp; data_out &lt;= 255" loc="a,dt"/>
		<prop exp="rst_n == 1 &amp;&amp; valid_out == 0 &amp;&amp; data_out &lt;= 255" loc="a,dt"/>
