<harm>
	<context name="default">
		<prop exp="rst_n == 0" loc="a,dt"/>
		<prop exp="valid_out == 0" loc="c"/>
		<prop exp="data_out == 0" loc="c"/>
		<prop exp="valid_out == 1" loc="a,dt"/>
		<prop exp="valid_in == 0" loc="a,dt"/>
		<prop exp="data_out &lt;= 255" loc="c"/>
		<prop exp="valid_in == 1" loc="a,dt"/>
		<prop exp="data_in == data_out" loc="a,c,dt"/>
		<prop exp="data_in &gt;= data_out" loc="a,c,dt"/>
		<prop exp="data_in &lt; data_out" loc="a,c,dt"/>
		<prop exp="data_in + data_out &lt;= 65535" loc="a,c,dt"/>
		<prop exp="valid_in == 0 &amp;&amp; valid_out == 1" loc="a,dt"/>
		<prop exp="valid_in == 1 &amp;&amp; valid_out == 1" loc="a,dt"/>
