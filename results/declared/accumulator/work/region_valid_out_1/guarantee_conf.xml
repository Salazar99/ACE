		<prop exp="valid_in == 0 &amp;&amp; valid_out == 0 &amp;&amp; data_in &lt; data_out &amp;&amp; data_out &lt;= 255" loc="a,dt"/>
		<prop exp="rst_n == 1 &amp;&amp; valid_in == 0 &amp;&amp; valid_out == 0 &amp;&amp; data_in &gt;= data_out" loc="a,dt"/>
		<prop exp="valid_in == 1 &amp;&amp; valid_out == 0 &amp;&amp; data_in &lt; data_out &amp;&amp; data_out &lt;= 255" loc="a,dt"/>
		<prop exp="$rose(rst_n)" loc="a,dt"/>
		<prop exp="$fell(rst_n)" loc="a,dt"/>
		<prop exp="$rose(valid_in)" loc="a,dt"/>
		<prop exp="$fell(valid_in)" loc="a,dt"/>
		<prop exp="$rose(valid_out)" loc="a,dt"/>
		<prop exp="$fell(valid_out)" loc="a,dt"/>
		<prop exp="rst_n" loc="a,c,dt"/>
		<prop exp="valid_in" loc="a,c,dt"/>
		<prop exp="valid_out" loc="a,c,dt"/>
		<numeric clustering="K,10Max,0.01WCSS,&gt;&lt;,==" exp="data_in" loc="a,c,dt"/>
		<numeric clustering="K,10Max,0.01WCSS,&gt;&lt;,==" exp="data_out" loc="a,c,dt"/>
		<template exp="G(P0 |-&gt; P1)" />
		<template exp="G(P0 |=&gt; P1)" />
		<template exp="G(P0 |-&gt; ##[1:5] P1)" />
		<sort name="smoothed_recall" exp="(atct+1)/(atct+afct+2)"/>
	</context>
</harm>
