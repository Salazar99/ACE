{
 "name": "fifo_sync",
 "traces": [
  "../traces/fifo_sync/mine_*.csv"
 ],
 "holdout": [
  "../traces/fifo_sync/holdout_*.csv"
 ],
 "inputs": [
  "rst_n",
  "wr_en",
  "rd_en",
  "din"
 ],
 "outputs": [
  "dout",
  "full",
  "empty",
  "count"
 ],
 "events": [
  "full == 1",
  "empty == 1"
 ],
 "horizon": 4,
 "h_pre": 2,
 "h_post": 4,
 "grammar": "G3",
 "episode_mode": "split",
 "reset": "rst_n == 0",
 "max_antecedent_props": 3,
 "extra_props": [
  {
   "exp": "dout == din",
   "loc": "c",
   "stage": "guarantee"
  }
 ],
 "references": [
  "G((rst_n == 0) |=> (count == 0))",
  "G((rst_n == 0) |=> (empty == 1))",
  "G((rst_n == 0) |=> (full == 0))",
  "G((count == 0) |-> (empty == 1))",
  "G((empty == 1) |-> (count == 0))",
  "G((count == 8) |-> (full == 1))",
  "G((full == 1) |-> (count == 8))",
  "G((count >= 1) |-> (empty == 0))",
  "G((count <= 7) |-> (full == 0))",
  "G(count <= 8)",
  "G((empty == 1 && wr_en == 1) |=> (count == 1))",
  "G((empty == 1 && wr_en == 1) |=> (empty == 0))",
  "G((empty == 1 && wr_en == 0) |=> (empty == 1))",
  "G((full == 1 && rd_en == 0) |=> (full == 1))",
  "G((count == 7 && wr_en == 1 && rd_en == 0) |=> (full == 1))",
  "G((count == 4 && wr_en == 1 && rd_en == 0) |=> (count == 5))",
  "G((count == 1 && rd_en == 1 && wr_en == 0) |=> (empty == 1))",
  "G((wr_en == 1 && rd_en == 1 && full == 0 && empty == 0) |=> (count >= 1))",
  "G((empty == 1 && wr_en == 1) |=> (dout == din))"
 ],
 "reference_assumptions": [
  "rst_n == 1",
  "din <= 255"
 ]
}
