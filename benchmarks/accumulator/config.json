{
 "name": "accumulator",
 "traces": [
  "../traces/accumulator/mine_*.csv"
 ],
 "holdout": [
  "../traces/accumulator/holdout_*.csv"
 ],
 "inputs": [
  "rst_n",
  "valid_in",
  "data_in"
 ],
 "outputs": [
  "valid_out",
  "data_out"
 ],
 "events": [
  "valid_out == 1"
 ],
 "horizon": 5,
 "h_pre": 4,
 "h_post": 5,
 "grammar": "G3",
 "episode_mode": "split",
 "references": [
  "G((rst_n == 0) |-> (valid_out == 0))",
  "G((rst_n == 0) |-> (data_out == 0))",
  "G((valid_out == 1) |=> (valid_out == 0))",
  "G((valid_out == 1 && valid_in == 0) |=> (valid_out == 0))",
  "G((valid_out == 1 && valid_in == 1) |=> (data_out <= 255))"
 ],
 "reset": "rst_n == 0",
 "extra_props": [
  {
   "exp": "rst_n == 0",
   "loc": "a,dt",
   "stage": "guarantee"
  },
  {
   "exp": "valid_out == 0",
   "loc": "c",
   "stage": "guarantee"
  },
  {
   "exp": "data_out == 0",
   "loc": "c",
   "stage": "guarantee"
  },
  {
   "exp": "valid_out == 1",
   "loc": "a,dt",
   "stage": "guarantee"
  },
  {
   "exp": "valid_in == 0",
   "loc": "a,dt",
   "stage": "guarantee"
  },
  {
   "exp": "data_out <= 255",
   "loc": "c",
   "stage": "guarantee"
  },
  {
   "exp": "valid_in == 1",
   "loc": "a,dt",
   "stage": "guarantee"
  }
 ],
 "reference_assumptions": [
  "rst_n == 1",
  "valid_in == 1",
  "data_in <= 255"
 ]
}
