 "out_of_grammar": [
  {
   "id": "FIFO-ORDER",
   "assumption": "rst_n == 1 && the environment respects the flags",
   "guarantee": "the k-th value read equals the k-th value written",
   "why_not_minable": "first-in-first-out order relates a read to a write that happened an unbounded number of cycles earlier. No template reaches back that far and no past operator exists in the evaluator; FIFO19 is the one-entry case, which is the deepest form the language can state",
   "minable": false
  },
  {
   "id": "FIFO-INCREMENT",
   "assumption": "rst_n == 1",
   "guarantee": "G(wr_en && !rd_en && !full |=> count == $past(count) + 1)",
   "why_not_minable": "the general occupancy relation needs $past. FIFO15-17 pin it at individual occupancies instead, which is what a value-equality vocabulary can express",
   "minable": false
  },
  {
   "id": "FIFO-PROTECTION",
   "assumption": "none",
   "guarantee": "G(full && wr_en && !rd_en |=> count == 8) and G(empty && rd_en && !wr_en |=> count == 0)",
   "why_not_minable": "these are true of the RTL and expressible in the grammar, but the nominal environment never writes into a full queue or reads an empty one, so they have zero support on the mining corpus and cannot be confirmed there. They hold with support on the STRESS corpus, which is the one place the reference set is deliberately not validated - a benchmark gap of exactly the kind the CSR error flag has",
   "minable": false
  }
 ]
