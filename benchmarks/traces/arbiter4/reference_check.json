 "out_of_grammar": [
  {
   "id": "ARB-ROTATION",
   "assumption": "rst_n == 1",
   "guarantee": "$past(gnt_id) == i |-> the next grant goes to the first requester at or after i+1",
   "why_not_minable": "round-robin order is a relation between consecutive grants, so it needs a past operator over the granted index. The evaluator has no $past (HARM's proposition grammar does), and the rotation pointer is not an observable output",
   "minable": false
  },
  {
   "id": "ARB-NO-CONSECUTIVE",
   "assumption": "rst_n == 1 && two requesters asking",
   "guarantee": "no requester is granted twice in a row while another is asking",
   "why_not_minable": "same past-operator problem: the property compares a grant against the previous grant. It is the fairness property an engineer would write, and the bounded-window form (ARB15-18) is what the template family can express instead",
   "minable": false
  },
  {
   "id": "ARB-STARVATION",
   "assumption": "rst_n == 1 && req_i held until granted",
   "guarantee": "F(gnt_i == 1)",
   "why_not_minable": "unbounded liveness is not a finite-trace property and no template in the family is unbounded. The four-cycle window is the finite-trace surrogate, and it is only true because the rotation makes the bound exist",
   "minable": false
  },
  {
   "id": "ARB-HOLD",
   "assumption": "rst_n == 1",
   "guarantee": "G(gnt_i == 1 |-> $past(req_i) == 1)",
   "why_not_minable": "a grant answers the PREVIOUS cycle's request, and the requester drops its request as soon as it is served, so 'a grant only goes to someone asking' is false in the same-sample form and needs $past. ARB5 is the in-grammar statement of the same idea: with nobody asking, nobody is granted",
   "minable": false
  }
 ]
